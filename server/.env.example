# Скопируйте в .env и заполните значения

# Подключение к PostgreSQL
DATABASE_URL=postgres://aura:aura@localhost:5432/aura?sslmode=disable

# Порт API-сервера
PORT=8080

# Пароль входа в админ-панель (/admin.html)
ADMIN_PASSWORD=aura2026

# Секрет для подписи токенов авторизации — замените на случайную строку
AUTH_SECRET=aura-dev-secret-change-me

# Telegram-бот для заказов (пока пусто — заказы пишутся в лог сервера)
TG_BOT_TOKEN=
TG_CHAT_ID=
